# Copy this file to ".env" (in this same backend folder) and fill in real values.
# Never commit the real .env file.

# Local MongoDB (each teammate's own machine) or a shared MongoDB Atlas URI
MONGO_URI=mongodb://127.0.0.1:27017/JobNestDB

# Port for the Express API. React runs on 3000, so the API uses 5000.
PORT=5000

# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=1d

# Address of the React app (used for CORS)
CLIENT_URL=http://localhost:3000

# Employers must be approved by an admin before they can post jobs (true/false)
REQUIRE_EMPLOYER_VERIFICATION=true

# Used only by "npm run create-admin"
ADMIN_NAME=JobNest Admin
ADMIN_EMAIL=admin@jobnest.local
ADMIN_PASSWORD=ChangeMe123

# Optional: SMTP settings for application confirmation emails.
# If SMTP_HOST is empty, emails are printed in the backend terminal instead of being sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail.com
SMTP_PASS=your_16_letter_app_password
MAIL_FROM="JobNest <no-reply@jobnest.local>"
